generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
}

// ============================================================================
// PART 1: DATABASE ENUMS
// ============================================================================

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  PAYSTACK
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RESTOCK
  DAMAGE
  RESERVATION
  RELEASE
  MANUAL_ADJUSTMENT
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum LiveChatStatus {
  OPEN
  PENDING
  CLOSED
}

enum SenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionType {
  FLASH_SALE
  BUNDLE_DISCOUNT
  BUY_ONE_GET_ONE
  SEASONAL
}

// ============================================================================
// PART 2: CORE BUSINESS ENTITIES
// ============================================================================

model Administrator {
  id             String    @id @default(uuid()) @db.Uuid
  auth_user_id   String    @unique
  full_name      String
  email          String    @unique
  phone          String?
  avatar_url     String?
  is_active      Boolean   @default(true)
  last_login_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  inventory_movements InventoryMovement[]
  audit_logs          AuditLog[]
  generated_reports   Report[]
  assigned_chats      LiveChatConversation[]
  login_histories     LoginHistory[]

  @@map("administrators")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  auth_user_id   String    @unique
  first_name     String
  last_name      String
  email          String    @unique
  phone          String?
  avatar_url     String?
  date_of_birth  DateTime?
  is_verified    Boolean   @default(false)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  addresses       CustomerAddress[]
  orders          Order[]
  reviews         ProductReview[]
  wishlist_items  WishlistItem[]
  compare_items   CompareItem[]
  recently_viewed RecentlyViewed[]
  shopping_carts  ShoppingCart[]
  notifications   Notification[]
  chat_conversations LiveChatConversation[]
  activity_history CustomerActivityHistory[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerAddress {
  id                  String   @id @default(uuid()) @db.Uuid
  customer_id         String   @db.Uuid
  full_name           String
  phone               String
  address_line_1      String
  address_line_2      String?
  city                String
  state               String
  country             String   @default("Nigeria")
  postal_code         String?
  is_default_billing  Boolean  @default(false)
  is_default_shipping Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  customer            Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  billing_orders      Order[]  @relation("BillingAddress")
  shipping_orders     Order[]  @relation("ShippingAddress")

  @@index([customer_id])
  @@map("customer_addresses")
}

model Brand {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  logo_url        String?
  description     String?
  is_featured     Boolean   @default(false)
  is_active       Boolean   @default(true)
  seo_title       String?
  seo_description String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  products        Product[]

  @@index([slug])
  @@map("brands")
}

model Category {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  description     String?
  image_url       String?
  banner_url      String?
  display_order   Int       @default(0)
  is_featured     Boolean   @default(false)
  is_active       Boolean   @default(true)
  seo_title       String?
  seo_description String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  products        Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  brand_id          String        @db.Uuid
  category_id       String        @db.Uuid
  name              String
  slug              String        @unique
  short_description String?
  description       String?
  sku_prefix        String        @unique
  status            ProductStatus @default(DRAFT)
  is_featured       Boolean       @default(false)
  is_flash_sale     Boolean       @default(false)
  is_active         Boolean       @default(true)
  seo_title         String?
  seo_description   String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?

  brand             Brand                  @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  category          Category               @relation(fields: [category_id], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  images            ProductImage[]
  specifications    ProductSpecification[]
  reviews           ProductReview[]
  wishlist_items    WishlistItem[]
  compare_items     CompareItem[]
  recently_viewed   RecentlyViewed[]
  cart_items        CartItem[]
  order_items       OrderItem[]
  promotions        PromotionProduct[]
  bundle_items      ProductBundleItem[]
  flash_sales       FlashSale[]

  @@index([slug])
  @@index([brand_id])
  @@index([category_id])
  @@map("products")
}

model ProductVariant {
  id               String   @id @default(uuid()) @db.Uuid
  product_id       String   @db.Uuid
  variant_name     String
  sku              String   @unique
  barcode          String?  @unique
  serial_required  Boolean  @default(false)
  price            Decimal  @db.Decimal(12, 2)
  compare_at_price Decimal? @db.Decimal(12, 2)
  cost_price       Decimal? @db.Decimal(12, 2)
  weight           Decimal? @db.Decimal(8, 2)
  is_default       Boolean  @default(false)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  product          Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images           ProductImage[]
  inventories      Inventory[]
  wishlist_items   WishlistItem[]
  cart_items       CartItem[]
  order_items      OrderItem[]
  flash_sales      FlashSale[]

  @@index([product_id])
  @@index([sku])
  @@index([barcode])
  @@map("product_variants")
}

model ProductImage {
  id            String   @id @default(uuid()) @db.Uuid
  product_id    String   @db.Uuid
  variant_id    String?  @db.Uuid
  image_url     String
  alt_text      String?
  display_order Int      @default(0)
  is_featured   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  product       Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@index([variant_id])
  @@map("product_images")
}

model ProductSpecification {
  id                  String   @id @default(uuid()) @db.Uuid
  product_id          String   @db.Uuid
  specification_name  String
  specification_value String
  display_order       Int      @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_specifications")
}

model Inventory {
  id                  String   @id @default(uuid()) @db.Uuid
  variant_id          String   @db.Uuid
  warehouse_id        String   @db.Uuid
  available_quantity  Int      @default(0)
  reserved_quantity   Int      @default(0)
  incoming_quantity   Int      @default(0)
  low_stock_threshold Int      @default(5)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  variant             ProductVariant      @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  warehouse           Warehouse           @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  movements           InventoryMovement[]

  @@unique([variant_id, warehouse_id])
  @@index([variant_id])
  @@index([warehouse_id])
  @@map("inventories")
}

model Warehouse {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  address    String
  city       String
  state      String
  country    String   @default("Nigeria")
  phone      String?
  email      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  inventories Inventory[]

  @@map("warehouses")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  inventory_id   String                @db.Uuid
  movement_type  InventoryMovementType
  quantity       Int
  reference_type String?
  reference_id   String?
  notes          String?
  performed_by   String?               @db.Uuid
  created_at     DateTime              @default(now())

  inventory      Inventory             @relation(fields: [inventory_id], references: [id], onDelete: Restrict)
  admin          Administrator?        @relation(fields: [performed_by], references: [id], onDelete: SetNull)

  @@index([inventory_id])
  @@index([reference_id])
  @@map("inventory_movements")
}

model WishlistItem {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  product_id  String   @db.Uuid
  variant_id  String?  @db.Uuid
  created_at  DateTime @default(now())

  customer    Customer        @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, product_id, variant_id])
  @@index([customer_id])
  @@index([product_id])
  @@map("wishlist_items")
}

model CompareItem {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  product_id  String   @db.Uuid
  created_at  DateTime @default(now())

  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, product_id])
  @@index([customer_id])
  @@map("compare_items")
}

model RecentlyViewed {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  product_id  String   @db.Uuid
  viewed_at   DateTime @default(now())

  customer    Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([viewed_at])
  @@map("recently_viewed")
}

// ============================================================================
// PART 3: COMMERCE & TRANSACTIONAL ENTITIES
// ============================================================================

model ShoppingCart {
  id              String   @id @default(uuid()) @db.Uuid
  customer_id     String?  @db.Uuid
  session_id      String?  @unique
  coupon_id       String?  @db.Uuid
  subtotal        Decimal  @default(0) @db.Decimal(12, 2)
  discount_amount Decimal  @default(0) @db.Decimal(12, 2)
  shipping_amount Decimal  @default(0) @db.Decimal(12, 2)
  tax_amount      Decimal  @default(0) @db.Decimal(12, 2)
  total_amount    Decimal  @default(0) @db.Decimal(12, 2)
  expires_at      DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  customer        Customer?  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  coupon          Coupon?    @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items           CartItem[]

  @@index([customer_id])
  @@index([session_id])
  @@map("shopping_carts")
}

model CartItem {
  id          String   @id @default(uuid()) @db.Uuid
  cart_id     String   @db.Uuid
  product_id  String   @db.Uuid
  variant_id  String?  @db.Uuid
  quantity    Int      @default(1)
  unit_price  Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  cart        ShoppingCart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@unique([cart_id, product_id, variant_id])
  @@index([cart_id])
  @@map("cart_items")
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  order_number        String        @unique
  customer_id         String        @db.Uuid
  billing_address_id  String?       @db.Uuid
  shipping_address_id String?       @db.Uuid
  shipping_method_id  String?       @db.Uuid
  coupon_id           String?       @db.Uuid
  status              OrderStatus   @default(PENDING)
  payment_status      PaymentStatus @default(PENDING)
  fulfillment_status  String        @default("UNFULFILLED")
  currency            String        @default("NGN")
  subtotal            Decimal       @db.Decimal(12, 2)
  discount_amount     Decimal       @default(0) @db.Decimal(12, 2)
  shipping_amount     Decimal       @default(0) @db.Decimal(12, 2)
  tax_amount          Decimal       @default(0) @db.Decimal(12, 2)
  total_amount        Decimal       @db.Decimal(12, 2)
  notes               String?
  placed_at           DateTime      @default(now())
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  customer            Customer         @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  billing_address     CustomerAddress? @relation("BillingAddress", fields: [billing_address_id], references: [id], onDelete: SetNull)
  shipping_address    CustomerAddress? @relation("ShippingAddress", fields: [shipping_address_id], references: [id], onDelete: SetNull)
  shipping_method     ShippingMethod?  @relation(fields: [shipping_method_id], references: [id], onDelete: SetNull)
  coupon              Coupon?          @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  invoices            Invoice[]

  @@index([customer_id])
  @@index([order_number])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  order_id       String   @db.Uuid
  product_id     String   @db.Uuid
  variant_id     String?  @db.Uuid
  product_name   String
  variant_name   String?
  sku            String
  quantity       Int
  unit_price     Decimal  @db.Decimal(12, 2)
  discount_amount Decimal @default(0) @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())

  order          Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  reviews        ProductReview[]

  @@index([order_id])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  order_id       String        @db.Uuid
  payment_method PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("NGN")
  paid_at        DateTime?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  order          Order                @relation(fields: [order_id], references: [id], onDelete: Restrict)
  transactions   PaymentTransaction[]

  @@index([order_id])
  @@index([status])
  @@map("payments")
}

model PaymentTransaction {
  id                      String    @id @default(uuid()) @db.Uuid
  payment_id              String    @db.Uuid
  provider                String
  provider_reference      String?   @unique
  provider_status         String?
  authorization_reference String?
  webhook_reference       String?
  raw_response            Json?
  verified_at             DateTime?
  created_at              DateTime  @default(now())

  payment                 Payment   @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([provider_reference])
  @@map("payment_transactions")
}

model ShippingMethod {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  description             String?
  estimated_delivery_days Int      @default(3)
  base_price              Decimal  @db.Decimal(12, 2)
  is_pickup               Boolean  @default(false)
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  orders                  Order[]

  @@map("shipping_methods")
}

model PickupStation {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  address       String
  city          String
  state         String
  phone         String?
  opening_hours String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("pickup_stations")
}

model Coupon {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  description      String?
  discount_type    DiscountType
  discount_value   Decimal      @db.Decimal(12, 2)
  minimum_purchase Decimal?     @db.Decimal(12, 2)
  maximum_discount Decimal?     @db.Decimal(12, 2)
  expires_at       DateTime?
  usage_limit      Int?
  usage_count      Int          @default(0)
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?

  shopping_carts   ShoppingCart[]
  orders           Order[]

  @@index([code])
  @@map("coupons")
}

model Promotion {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  promotion_type PromotionType
  description    String?
  starts_at      DateTime
  ends_at        DateTime
  priority       Int              @default(0)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  deleted_at     DateTime?

  products       PromotionProduct[]

  @@map("promotions")
}

model PromotionProduct {
  id           String    @id @default(uuid()) @db.Uuid
  promotion_id String    @db.Uuid
  product_id   String    @db.Uuid
  created_at   DateTime  @default(now())

  promotion    Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, product_id])
  @@index([promotion_id])
  @@index([product_id])
  @@map("promotion_products")
}

model FlashSale {
  id               String          @id @default(uuid()) @db.Uuid
  product_id       String          @db.Uuid
  variant_id       String?         @db.Uuid
  sale_price       Decimal         @db.Decimal(12, 2)
  starts_at        DateTime
  ends_at          DateTime
  maximum_quantity Int?
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  product          Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([starts_at, ends_at])
  @@map("flash_sales")
}

model ProductBundle {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  bundle_price Decimal             @db.Decimal(12, 2)
  is_active    Boolean             @default(true)
  starts_at    DateTime?
  ends_at      DateTime?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  items        ProductBundleItem[]

  @@map("product_bundles")
}

model ProductBundleItem {
  id         String        @id @default(uuid()) @db.Uuid
  bundle_id  String        @db.Uuid
  product_id String        @db.Uuid
  quantity   Int           @default(1)
  created_at DateTime      @default(now())

  bundle     ProductBundle @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([bundle_id, product_id])
  @@index([bundle_id])
  @@map("product_bundle_items")
}

model ProductReview {
  id            String     @id @default(uuid()) @db.Uuid
  customer_id   String     @db.Uuid
  product_id    String     @db.Uuid
  order_item_id String?    @db.Uuid
  rating        Int
  title         String?
  review        String?
  likes_count   Int        @default(0)
  is_approved   Boolean    @default(false)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  customer      Customer   @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order_item    OrderItem? @relation(fields: [order_item_id], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@index([customer_id])
  @@map("product_reviews")
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  order_id       String   @db.Uuid
  invoice_number String   @unique
  invoice_url    String?
  issued_at      DateTime @default(now())
  created_at     DateTime @default(now())

  order          Order    @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@map("invoices")
}

// ============================================================================
// PART 4: CMS, COMMUNICATION, ANALYTICS & SYSTEM ENTITIES
// ============================================================================

model CmsPage {
  id               String    @id @default(uuid()) @db.Uuid
  title            String
  slug             String    @unique
  content          String
  meta_title       String?
  meta_description String?
  is_published     Boolean   @default(false)
  published_at     DateTime?
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  @@index([slug])
  @@map("cms_pages")
}

model HomepageBanner {
  id               String    @id @default(uuid()) @db.Uuid
  title            String
  subtitle         String?
  image_url        String
  mobile_image_url String?
  button_text      String?
  button_link      String?
  display_order    Int       @default(0)
  starts_at        DateTime?
  ends_at          DateTime?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@map("homepage_banners")
}

model HomepageSection {
  id            String   @id @default(uuid()) @db.Uuid
  section_key   String   @unique
  title         String?
  subtitle      String?
  display_order Int      @default(0)
  is_enabled    Boolean  @default(true)
  configuration Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("homepage_sections")
}

model EmailTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  subject      String
  html_content String
  text_content String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("email_templates")
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  customer_id String              @db.Uuid
  type        String
  title       String
  message     String
  channel     NotificationChannel @default(IN_APP)
  is_read     Boolean             @default(false)
  read_at     DateTime?
  created_at  DateTime            @default(now())

  customer    Customer            @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([is_read])
  @@map("notifications")
}

model LiveChatConversation {
  id                String          @id @default(uuid()) @db.Uuid
  customer_id       String          @db.Uuid
  status            LiveChatStatus  @default(OPEN)
  assigned_admin_id String?         @db.Uuid
  started_at        DateTime        @default(now())
  closed_at         DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  customer          Customer        @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  admin             Administrator?  @relation(fields: [assigned_admin_id], references: [id], onDelete: SetNull)
  messages          LiveChatMessage[]

  @@index([customer_id])
  @@index([status])
  @@map("live_chat_conversations")
}

model LiveChatMessage {
  id              String               @id @default(uuid()) @db.Uuid
  conversation_id String               @db.Uuid
  sender_type     SenderType
  sender_id       String               @db.Uuid
  message         String
  attachment_url  String?
  sent_at         DateTime             @default(now())

  conversation    LiveChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@map("live_chat_messages")
}

model Report {
  id               String         @id @default(uuid()) @db.Uuid
  report_type      String
  generated_by     String?        @db.Uuid
  file_url         String
  filters          Json?
  generated_at     DateTime       @default(now())

  admin            Administrator? @relation(fields: [generated_by], references: [id], onDelete: SetNull)

  @@map("reports")
}

model AnalyticsSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  snapshot_date    DateTime @unique @db.Date
  total_revenue    Decimal  @default(0) @db.Decimal(14, 2)
  total_orders     Int      @default(0)
  total_customers  Int      @default(0)
  repeat_customers Int      @default(0)
  top_category     String?
  top_product      String?
  created_at       DateTime @default(now())

  @@index([snapshot_date])
  @@map("analytics_snapshots")
}

model WebsiteSetting {
  id               String               @id @default(uuid()) @db.Uuid
  company_name     String               @default("HOPSY PLAZA")
  company_email    String               @default("support@hopsyplaza.com")
  company_phone    String?
  company_address  String?
  business_hours   String?
  currency         String               @default("NGN")
  default_country  String               @default("Nigeria")
  maintenance_mode Boolean              @default(false)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt

  social_settings  SocialMediaSetting[]

  @@map("website_settings")
}

model SocialMediaSetting {
  id                 String          @id @default(uuid()) @db.Uuid
  website_setting_id String?         @db.Uuid
  facebook_url       String?
  instagram_url      String?
  x_url              String?
  linkedin_url       String?
  youtube_url        String?
  tiktok_url         String?
  whatsapp_number    String?
  updated_at         DateTime        @updatedAt

  website_setting    WebsiteSetting? @relation(fields: [website_setting_id], references: [id], onDelete: Cascade)

  @@map("social_media_settings")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  admin_id    String?        @db.Uuid
  action      String
  entity_type String
  entity_id   String?
  old_values  Json?
  new_values  Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime       @default(now())

  admin       Administrator? @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([admin_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model LoginHistory {
  id             String        @id @default(uuid()) @db.Uuid
  admin_id       String        @db.Uuid
  ip_address     String?
  user_agent     String?
  device_name    String?
  login_at       DateTime      @default(now())
  logout_at      DateTime?
  was_successful Boolean       @default(true)

  admin          Administrator @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([login_at])
  @@map("login_histories")
}

model CustomerActivityHistory {
  id            String   @id @default(uuid()) @db.Uuid
  customer_id   String   @db.Uuid
  activity_type String
  description   String?
  created_at    DateTime @default(now())

  customer      Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([created_at])
  @@map("customer_activity_histories")
}
